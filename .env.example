# AWS 자격증명 (IAM ReadOnly 권한)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # 임시 자격증명 시 사용

# Claude API
ANTHROPIC_API_KEY=

# Slack (선택)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#aws-alerts

# 감지 임계값 (선택 — 기본값 사용 가능)
COST_SPIKE_PCT=50      # 비용 N% 이상 급증 시 알림
CPU_IDLE_PCT=5         # CPU N% 이하 → 유휴 판단
CPU_IDLE_HOURS=24      # 유휴 판단 기간

# 수집 주기 (초)
COLLECT_INTERVAL=900   # 15분
SECURITY_INTERVAL=3600 # 1시간
